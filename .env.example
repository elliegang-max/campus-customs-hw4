# Campus Customs — environment template. Copy to `.env` and fill in real values.
# Never commit your real .env (it is git-ignored).

# Portkey gateway (fronts the course's OpenAI-compatible models).
# The backend reads these; if unset it also falls back to
# ~/.config/ai-keys/keys.env.
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://your-portkey-gateway-base-url

# Secret used to sign session cookies. Any long random string.
# If unset, a random key is generated at startup (sessions reset on restart).
CAMPUS_CUSTOMS_SECRET_KEY=change-me-to-a-long-random-string
